{
    "name": "SHU",
    "description": "A chrome extention that introduces an API that enables developers to make utility plugins for JitsiMeet based systems like Shkolo's virtual school.",
    "version": "2.0",
    "manifest_version": 3,
    "content_scripts": [{
        "matches": ["https://meet.jit.si/*", "https://vs.shkolo.bg/*"],
        "js": ["content.js"]
    }],
    "action": {
        "default_title": "SHU",
        "default_icon": "icon.png",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html"
}